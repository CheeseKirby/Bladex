# AI Workflow 环境变量模板
# 复制为 .env 并填入真实值(.env 不应提交版本控制)

# ─── LLM 配置(必填)──────────────────────────────────────
# Anthropic 兼容网关 token(火山方舟/中转网关均可)
ANTHROPIC_AUTH_TOKEN=replace-with-your-token

# LLM 网关地址(火山方舟示例;Claude 官方为 https://api.anthropic.com)
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding

# 模型名(glm-5.1 / glm-latest / claude-sonnet-4-6 等)
LLM_MODEL=glm-latest

# ─── 数据库(必填)──────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=root

# ─── 路径配置(可选,有默认值)─────────────────────────────
# 工作流产物输出根(相对 ai-developer/ai-workflow 运行目录)
AI_WORKFLOW_OUTPUT_ROOT=../../ai-generated-modules

# 生成产物写入根（默认隔离区）
TARGET_PROJECT_ROOT=../../ai-generated-modules

# 可选：启动时自动加载的参考项目绝对路径；留空时可在页面或接口中选择
REFERENCE_PROJECT_ROOT=

# BladeX 规范文档路径(默认从 jar 内 classpath 加载)
CONVENTION_DOCS_PATH=classpath:bladex-docs/

# ─── 服务地址(可选)────────────────────────────────────
# BFF 端口(默认 3004;与 BladeX 等其他服务并存时改此项避开冲突)
# 注意:BFF 读 PORT,vite 代理读 VITE_BFF_PORT,两者必须相同
HOST=127.0.0.1
PORT=3004
VITE_BFF_PORT=3004

# BFF 放行前端 CORS 来源(默认前端跑在 3005)
FRONTEND_ORIGIN=http://localhost:3005

# BFF 转发到 Part B(ai-workflow)的地址(默认 8111)
AI_WORKFLOW_HOST=127.0.0.1
PART_B_URL=http://localhost:8111

# Canonical Plan Contract v2 审核包的共享 HMAC-SHA256 密钥。
# 至少使用 32 个随机字节；缺失时 start.ps1 会安全生成并写入本机 .env。
PLAN_BUNDLE_SIGNING_SECRET=replace-with-a-random-64-character-hex-secret

# Part A 回调地址（BFF 监听端口见上）
PART_A_CALLBACK_URL=http://localhost:3004/api/transmission/status-update

# 管理端 token(未配置时只接受 127.0.0.1 / ::1)
BFF_JSON_LIMIT=2mb
BFF_LLM_RATE_LIMIT=30
BFF_LLM_RATE_WINDOW_MS=60000
# 可选：Part A 设计状态持久化文件；相对路径基于 ai-designer 解析
BFF_PLAN_STORE_PATH=../output/bff-projects.json
BFF_ADMIN_TOKEN=
AI_WORKFLOW_ADMIN_TOKEN=
